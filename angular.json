{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ng-mocks-sandbox": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist/ng-mocks-sandbox"
            },
            "index": "index.html",
            "polyfills": [
              "zone.js",
              "zone.js/testing",
              "jasmine-core/lib/jasmine-core/jasmine.js",
              "jasmine-core/lib/jasmine-core/jasmine-html.js",
              "jasmine-core/lib/jasmine-core/boot0.js",
              "jasmine-core/lib/jasmine-core/boot1.js"
            ],
            "tsConfig": "tsconfig.json",
            "styles": ["./node_modules/jasmine-core/lib/jasmine-core/jasmine.css"],
            "browser": "src/main.ts"
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "ng-mocks-sandbox:build"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": ["core-js/proposals/reflect-metadata", "zone.js", "zone.js/testing"],
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false,
    "cache": {
      "enabled": false
    }
  }
}
