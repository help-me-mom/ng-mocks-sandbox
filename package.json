{
  "name": "ng-mocks-sandbox",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "A sandbox with guides and examples to play with ng-mocks",
  "keywords": [
    "angular",
    "ng-mocks",
    "mock",
    "mocking",
    "test",
    "testing",
    "sandbox",
    "playground"
  ],
  "scripts": {
    "npm": "npm",
    "ng": "ng",
    "start": "ng test --watch",
    "serve": "ng serve",
    "test": "ng test --watch=false",
    "hooks:install": "husky",
    "prettier:repo": "prettier --log-level warn -u -w .",
    "prettier:check": "prettier -u -c .",
    "ts:check": "tsc --noEmit"
  },
  "dependencies": {
    "@angular/animations": "22.1.1",
    "@angular/common": "22.1.1",
    "@angular/compiler": "22.1.1",
    "@angular/core": "22.1.1",
    "@angular/forms": "22.1.1",
    "@angular/platform-browser": "22.1.1",
    "@angular/platform-browser-dynamic": "22.1.1",
    "@angular/router": "22.1.1",
    "@types/jasmine": "6.0.0",
    "core-js": "3.50.0",
    "jasmine-core": "6.3.0",
    "ng-mocks": "14.17.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular/build": "22.1.3",
    "@angular/cli": "22.1.3",
    "@angular/compiler-cli": "22.1.1",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@types/jasmine": "6.0.0",
    "@types/node": "24.13.3",
    "husky": "9.1.7",
    "istanbul-lib-instrument": "6.0.3",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-ie-launcher": "1.0.0",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.2.0",
    "karma-junit-reporter": "2.0.1",
    "npm": "11.19.0",
    "prettier": "3.9.6",
    "puppeteer": "25.6.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "npm": "11.19.0"
  },
  "overrides": {
    "karma-jasmine": {
      "jasmine-core": "$jasmine-core"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
